# Environment Configuration
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/finguard_lite
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/finguard_lite_test

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Daraja API Configuration (Sandbox)
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_PASSKEY=your-daraja-passkey
DARAJA_SHORTCODE=174379
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_WEBHOOK_SECRET=your-webhook-validation-secret

# LLM Integration
GEMINI_API_KEY=your-google-gemini-api-key

# Application Settings
APP_NAME=FinGuard Lite
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000", "https://your-frontend-domain.vercel.app"]

# Logging
LOG_LEVEL=INFO